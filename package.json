{
    "name": "atv-mac-remote",
    "version": "2.1.1",
    "main": "app/main.js",
    "description": "ATV Remote",
    "productName": "ATV Remote",
    "license": "MIT",
    "build": {
        "productName": "ATV Remote",
        "appId": "com.electron.atvMacRemote",
        "linux": {
            "target": [
                "AppImage",
                "pacman"
            ],
            "category": "Utility",
            "icon": "build/icon.png",
            "executableName": "atv-desktop-remote",
            "maintainer": "ATV Desktop Remote Contributors <noreply@example.com>",
            "vendor": "ATV Desktop Remote"
        },
        "appImage": {
            "artifactName": "atv-desktop-remote-${version}-${arch}.${ext}"
        },
        "pacman": {
            "packageName": "atv-desktop-remote",
            "artifactName": "atv-desktop-remote-${version}.${ext}"
        },
        "mac": {
            "category": "public.app-category.utilities",
            "hardenedRuntime": true,
            "gatekeeperAssess": false,
            "entitlements": "build/entitlements.mac.plist",
            "entitlementsInherit": "build/entitlements.mac.plist"
        }
    },
    "scripts": {
        "start": "electron app",
        "postinstall": "electron-builder install-app-deps",
        "fullclean": "npx rimraf node_modules app/node_modules dist",
        "clean": "npx rimraf node_modules app/node_modules",
        "reset": "npm run clean && npm install --legacy-peer-deps",
        "build": "npx electron-builder -m",
        "build:linux": "npx electron-builder -l",
        "docker-build": "./electron_docker.sh 'npm run build:win'",
        "build:win": "npx electron-builder -w",
        "build-arm": "npx electron-builder -m --arm64"
    },
    "devDependencies": {
        "electron": "^40.2.1",
        "electron-builder": "^26.7.0",
        "rimraf": "^6.1.2"
    },
    "dependencies": {
        "@electron/remote": "^2.1.2",
        "menubar": "^9.5.1"
    }
}
